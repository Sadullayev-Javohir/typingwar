@page
@model LoginModel
@{
    ViewData["Title"] = "Kirish";
}

<div class="tw-auth">
    <h2 class="tw-accent text-center mb-4">Kirish</h2>
    <form id="tw-auth-form" data-endpoint="/api/auth/login" class="tw-auth-form">
        <div class="mb-3">
            <label class="form-label">Foydalanuvchi nomi yoki email</label>
            <input class="form-control" name="usernameOrEmail" required autofocus>
        </div>
        <div class="mb-3">
            <label class="form-label">Parol</label>
            <input class="form-control" type="password" name="password" required>
        </div>
        <div class="tw-auth-err text-danger mb-2"></div>
        <button class="btn btn-tw w-100" type="submit">Kirish</button>
    </form>
    <p class="text-center mt-3 text-secondary">
        Hisobingiz yo'qmi? <a class="tw-accent" asp-page="/Register">Ro'yxatdan o'ting</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
