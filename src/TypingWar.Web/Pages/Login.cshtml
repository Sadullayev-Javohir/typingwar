@page
@model LoginModel
@{
    ViewData["Title"] = "Kirish — Google bilan kiring";
    ViewData["Description"] = "TypingWar.uz ga Google hisobingiz bilan kiring va yozish tezligingizni saqlang, reytingga chiqing, turnirlarda qatnashing.";
}

<div class="tw-gauth">
    <div class="tw-gauth-card">
        <div class="tw-gauth-logo">
            <img src="~/img/typingwar-logo.png" alt="TypingWar" height="52" onerror="this.style.display='none'" />
        </div>
        <h1 class="tw-gauth-title">TypingWar<span class="tw-accent">.uz</span></h1>
        <p class="tw-gauth-sub">Eng tez barmoqlar g'alaba qozonadi</p>

        @if (Model.HasError)
        {
            <div class="tw-gauth-err">@Model.ErrorMessage</div>
        }

        <a class="tw-google-btn" href="/api/auth/google">
            <span class="tw-google-ic" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="20" height="20">
                    <path fill="#FFC107" d="M43.6 20.5h-1.9V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8a12 12 0 1 1 0-24c3 0 5.8 1.1 7.9 3l5.7-5.7A20 20 0 1 0 24 44c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8A12 12 0 0 1 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7A20 20 0 0 0 6.3 14.7z"/>
                    <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.7 28l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                    <path fill="#1976D2" d="M43.6 20.5H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C41.4 36.3 44 30.6 44 24c0-1.3-.1-2.3-.4-3.5z"/>
                </svg>
            </span>
            <span>Google bilan davom etish</span>
        </a>

        <p class="tw-gauth-hint">
            Kirish va ro'yxatdan o'tish faqat Google akkaunti orqali amalga oshiriladi.
            Birinchi marta kirsangiz — foydalanuvchi nomi va hududni tanlaysiz.
        </p>
    </div>
</div>
