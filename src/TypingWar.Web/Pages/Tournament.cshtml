@page
@model TournamentModel
@{
    ViewData["Title"] = "Turnir";
}

<div id="tw-tournament" class="tw-tourn"
     data-authenticated="@Model.IsAuthenticated.ToString().ToLower()"
     data-username="@Model.Username"
     data-userid="@Model.UserId">

    <!-- Sarlavha -->
    <header class="tw-tourn-header">
        <div class="tw-tourn-htext">
            <span id="tw-tstatus" class="tw-tbadge">…</span>
            <h1 id="tw-tname">…</h1>
            <p id="tw-tmeta" class="tw-tourn-sub"></p>
        </div>
        <div class="tw-tourn-hactions">
            <button id="tw-tshare" class="tw-rbtn tw-rbtn--outline tw-rbtn--sm">
                <i class="bi bi-link-45deg"></i><span>Havolani nusxalash</span>
            </button>
            <button id="tw-tdelete" class="tw-rbtn tw-rbtn--danger tw-rbtn--sm d-none">
                <i class="bi bi-trash3"></i><span>Turnirni o'chirish</span>
            </button>
        </div>
    </header>

    <div id="tw-terr" class="tw-rcard-err text-center"></div>

    <!-- Qulflangan ko'rinish: shaxsiy turnir, ruxsatsiz foydalanuvchi (parol so'raladi) -->
    <section id="tw-locked" class="tw-locked d-none">
        <div class="tw-locked-card">
            <div class="tw-locked-icon"><i class="bi bi-shield-lock-fill"></i></div>
            <h2>Shaxsiy turnir</h2>
            <p>Bu turnir parol bilan himoyalangan. Ko'rish va qatnashish uchun turnir egasidan parolni oling va kiriting.</p>
            <input id="tw-locked-input" class="tw-tinput" type="password" maxlength="64" placeholder="Turnir paroli" autocomplete="off">
            <div id="tw-locked-err" class="tw-pwm-err"></div>
            <div class="tw-locked-actions">
                <button id="tw-locked-ok" class="tw-rbtn"><i class="bi bi-unlock-fill"></i><span>OK</span></button>
                <a href="/Tournaments" class="tw-rbtn tw-rbtn--outline" style="text-decoration:none"><i class="bi bi-arrow-left-circle"></i><span>Orqaga</span></a>
            </div>
        </div>
    </section>

    <!-- Chempion banneri -->
    <div id="tw-champion" class="tw-tchampion d-none"></div>

    <!-- Ro'yxat bosqichi -->
    <section id="tw-reg" class="tw-treg d-none">
        <div class="tw-treg-grid">
            <div class="tw-treg-players">
                <h3><i class="bi bi-people-fill"></i> Ishtirokchilar <span id="tw-reg-count" class="tw-treg-count"></span></h3>
                <ul id="tw-reg-list" class="tw-seed-list"></ul>
                <p id="tw-host-seedhint" class="tw-thint d-none">
                    <i class="bi bi-arrows-move"></i> Strelkalar bilan seed tartibini belgilang (yuqori seed kuchsizroq yo'l/bye oladi va kuchli seedlar faqat finalda uchrashadi), <i class="bi bi-x-lg"></i> bilan o'yinchini chiqaring. Bracket ishtirokchilar soniga avtomatik moslanadi.
                </p>
            </div>
            <div class="tw-treg-side">
                <div id="tw-reg-actions">
                    <button id="tw-register" class="tw-rbtn d-none"><i class="bi bi-person-plus"></i><span>Qatnashish</span></button>
                    <div id="tw-registered" class="tw-treg-ok d-none"><i class="bi bi-check-circle-fill"></i> Siz ro'yxatdasiz</div>
                    <button id="tw-start" class="tw-rbtn tw-rbtn--gold d-none"><i class="bi bi-flag-fill"></i><span>Turnirni boshlash</span></button>
                    <p id="tw-login-hint" class="tw-thint d-none">Qatnashish uchun <a href="/Login" class="tw-accent">tizimga kiring</a>.</p>
                </div>
                <div id="tw-countdown-start" class="tw-tcd-start d-none"></div>
            </div>
        </div>
    </section>

    <!-- Host boshqaruv paneli (poyga bosqichi) -->
    <section id="tw-host-bar" class="tw-host-bar d-none">
        <div class="tw-host-bar-info">
            <i class="bi bi-sliders"></i>
            <span id="tw-host-status">Boshqaruv</span>
        </div>
        <button id="tw-startround" class="tw-rbtn tw-rbtn--gold tw-rbtn--sm d-none">
            <i class="bi bi-play-fill"></i><span>Raundni boshlash</span>
        </button>
    </section>

    <!-- Poyga maydoni (ishtirokchi yozadi) -->
    <section id="tw-stage" class="tw-tstage d-none">
        <div id="tw-countdown" class="tw-countdown d-none"></div>

        <div id="tw-race" class="d-none">
            <div class="tw-tmatch-head">
                <span class="tw-tmatch-me" id="tw-me-name">Siz</span>
                <span class="tw-tmatch-vs">VS</span>
                <span class="tw-tmatch-opp" id="tw-opp-name">Raqib</span>
            </div>

            <div class="tw-tlanes">
                <div class="tw-tlane" id="tw-lane-me"></div>
                <div class="tw-tlane" id="tw-lane-opp"></div>
            </div>

            <div class="tw-stats" id="tw-tstats">
                <div class="tw-stat" id="tw-stat-wpm"><span id="tw-wpm">0</span><label><i class="bi bi-speedometer2"></i>WPM</label></div>
                <div class="tw-stat" id="tw-stat-acc"><span id="tw-acc">100</span><label><i class="bi bi-bullseye"></i>Aniqlik %</label></div>
                <div class="tw-stat" id="tw-stat-timer"><span id="tw-timer">0</span><label><i class="bi bi-clock"></i>Soniya</label></div>
            </div>

            <div id="tw-wordswrap" class="tw-wordswrap">
                <div id="tw-words" class="tw-words" tabindex="0"></div>
            </div>
        </div>

        <div id="tw-wait-round" class="tw-twait d-none">
            <i class="bi bi-hourglass-split"></i>
            <p id="tw-wait-msg">Keyingi raundni kuting…</p>
        </div>
    </section>

    <!-- Bracket (hamma ko'radi) — markazda aylanuvchi oltin gepard kubogi -->
    <section id="tw-bracket-wrap" class="tw-bracket-wrap d-none">
        <h3 class="tw-bracket-title"><i class="bi bi-diagram-3"></i> Playoff bracket</h3>

        <!-- Playoff markazidagi 3D OLTIN GEPARD KUBOGI -->
        <div class="tw-trophy-stage">
            <div id="tw-trophy-3d" class="tw-trophy-3d">
                <div class="tw-trophy-fallback"><i class="bi bi-trophy-fill"></i></div>
            </div>
            <div id="tw-trophy-caption" class="tw-trophy-caption">
                <i class="bi bi-hourglass-split"></i> Chempionni kutmoqda…
            </div>
        </div>

        <div id="tw-bracket" class="tw-tbracket"></div>
    </section>

    <!-- Yakuniy joylar -->
    <section id="tw-standings" class="tw-standings d-none">
        <h3 class="tw-bracket-title"><i class="bi bi-bar-chart-line-fill"></i> Yakuniy natijalar</h3>
        <div id="tw-standings-body"></div>
    </section>
</div>

<!-- Tushib qolish (yutqazish) oynasi -->
<div id="tw-elim-overlay" class="tw-elim-overlay d-none">
    <div class="tw-elim-card">
        <div class="tw-elim-icon"><i class="bi bi-emoji-frown"></i></div>
        <h2>Yutqazdingiz</h2>
        <p id="tw-elim-text">Bu raundda raqibingiz tezroq yozdi.</p>
        <div id="tw-elim-stats" class="tw-elim-stats"></div>
        <div class="tw-elim-actions">
            <button id="tw-elim-watch" class="tw-rbtn tw-rbtn--gold"><i class="bi bi-broadcast"></i><span>Tomoshabin sifatida kuzatish</span></button>
            <a href="/Tournaments" class="tw-rbtn tw-rbtn--outline" style="text-decoration:none"><i class="bi bi-arrow-left-circle"></i><span>Turnirlarga qaytish</span></a>
        </div>
    </div>
</div>

<!-- G'alaba (keyingi raundga o'tish) toast -->
<div id="tw-advance-toast" class="tw-advance-toast d-none">
    <i class="bi bi-check-circle-fill"></i>
    <div><strong>Keyingi raundga o'tdingiz!</strong><span id="tw-advance-sub">Keyingi raundni kuting.</span></div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/tournament.js" asp-append-version="true"></script>
    <script type="module" src="~/js/tournament-trophy.js" asp-append-version="true"></script>
}
