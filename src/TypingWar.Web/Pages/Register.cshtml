@page
@model RegisterModel
@{
    ViewData["Title"] = "Ro'yxatdan o'tish";
}

<div class="tw-auth">
    <h2 class="tw-accent text-center mb-4">Ro'yxatdan o'tish</h2>
    <form id="tw-auth-form" data-endpoint="/api/auth/register" class="tw-auth-form">
        <div class="mb-3">
            <label class="form-label">Foydalanuvchi nomi</label>
            <input class="form-control" name="username" required autofocus minlength="3" maxlength="32">
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Parol (kamida 8 belgi)</label>
            <input class="form-control" type="password" name="password" required minlength="8">
        </div>
        <div class="mb-3">
            <label class="form-label">Hudud (ixtiyoriy)</label>
            <select class="form-select" name="regionCode">
                <option value="">— tanlanmagan —</option>
                @foreach (var r in Model.Regions)
                {
                    <option value="@r.Key">@r.Value</option>
                }
            </select>
        </div>
        <div class="tw-auth-err text-danger mb-2"></div>
        <button class="btn btn-tw w-100" type="submit">Ro'yxatdan o'tish</button>
    </form>
    <p class="text-center mt-3 text-secondary">
        Hisobingiz bormi? <a class="tw-accent" asp-page="/Login">Kiring</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
