@page
@model ContestModel
@{
    ViewData["Title"] = "Kunlik musobaqa";
}

<div id="tw-contest" class="tw-contest" data-authenticated="@Model.IsAuthenticated.ToString().ToLower()">
    <div class="text-center mb-3">
        <h2 class="tw-accent mb-0">Kunlik musobaqa</h2>
        <span id="tw-contest-date" class="text-secondary"></span>
    </div>

    <div id="tw-contest-streak" class="tw-streak d-none"></div>
    <div id="tw-contest-err" class="text-danger text-center"></div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div id="tw-contest-words" class="tw-words" tabindex="0"></div>
            <div class="d-flex justify-content-between mt-2">
                <span id="tw-contest-live" class="text-secondary small">0 wpm</span>
                <button id="tw-contest-reset" class="btn btn-sm btn-outline-warning">Qayta</button>
            </div>
            <p id="tw-contest-login" class="text-secondary small mt-2 d-none">
                Natijangiz hisoblanishi uchun <a asp-page="/Login" class="tw-accent">tizimga kiring</a>.
            </p>
            <div id="tw-contest-result" class="tw-result d-none mt-2"></div>
        </div>

        <div class="col-lg-5">
            <h6 class="text-secondary">Bugungi natijalar (top 20)</h6>
            <ol id="tw-contest-board" class="tw-ranks"></ol>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/contest.js" asp-append-version="true"></script>
}
