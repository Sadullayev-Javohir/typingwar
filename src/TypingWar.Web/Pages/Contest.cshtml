@page
@model ContestModel
@{
    ViewData["Title"] = "Kunlik musobaqa";
}

<div id="tw-contest" class="tw-contest-page" data-authenticated="@Model.IsAuthenticated.ToString().ToLower()">

    <div class="tw-contest-hero">
        <span class="tw-contest-badge"><i class="bi bi-trophy-fill"></i> Har kuni yangi matn</span>
        <h1 class="tw-contest-title">Kunlik musobaqa</h1>
        <p class="tw-contest-sub">
            Bugun barcha o'yinchilar bitta xil matnni yozadi — eng tez barmoqlar yetakchi bo'ladi.
            <span id="tw-contest-date" class="tw-contest-date"></span>
        </p>
        <div id="tw-contest-streak" class="tw-streak d-none"></div>
    </div>

    <div id="tw-contest-err" class="text-danger text-center mb-2"></div>
    <p id="tw-contest-login" class="text-secondary text-center small mb-3 d-none">
        Natijangiz hisoblanishi uchun <a asp-page="/Login" class="tw-accent">tizimga kiring</a>.
    </p>

    <div class="row g-4">
        <div class="col-lg-8">
            <div id="tw-contest-game" class="tw-practice">

                <div class="tw-stats">
                    <div class="tw-stat" id="tw-c-stat-wpm">
                        <span id="tw-c-wpm">0</span>
                        <label><i class="bi bi-speedometer2"></i>WPM</label>
                    </div>
                    <div class="tw-stat" id="tw-c-stat-acc">
                        <span id="tw-c-acc">100</span>
                        <label><i class="bi bi-bullseye"></i>Aniqlik %</label>
                    </div>
                    <div class="tw-stat" id="tw-c-stat-timer">
                        <span id="tw-c-timer">0</span>
                        <label><i class="bi bi-clock"></i>Soniya</label>
                    </div>
                </div>

                <div class="tw-practice-track">
                    <div class="tw-track">
                        <div class="tw-cheetah-run tw-cheetah-gold" id="tw-c-cheetah">
                            <svg class="tw-cheetah-svg" viewBox="0 0 80 50" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 28 C6 22 3 15 5 8" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                                <circle cx="5" cy="8" r="4" fill="currentColor"/>
                                <ellipse cx="35" cy="28" rx="22" ry="11" fill="currentColor"/>
                                <ellipse cx="54" cy="22" rx="9" ry="8" fill="currentColor"/>
                                <circle cx="64" cy="16" r="11" fill="currentColor"/>
                                <polygon points="57,8 55,1 61,7" fill="currentColor"/>
                                <polygon points="68,7 71,1 73,8" fill="currentColor"/>
                                <polygon points="58,8 56.5,3 61,8" fill="rgba(0,0,0,.28)"/>
                                <polygon points="69,7 71.5,2 73,8" fill="rgba(0,0,0,.28)"/>
                                <g class="tw-eye">
                                    <circle cx="68" cy="13" r="3.5" fill="#08081a"/>
                                    <circle cx="69" cy="12" r="1.2" fill="rgba(255,255,255,.9)"/>
                                </g>
                                <path d="M66,20 Q67,23 65,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                                <path d="M62,20 Q61,23 63,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                                <ellipse cx="74" cy="20" rx="3" ry="2.5" fill="currentColor"/>
                                <ellipse cx="74" cy="21" rx="1.5" ry="1.1" fill="rgba(0,0,0,.35)"/>
                                <circle cx="25" cy="23" r="2.8" fill="rgba(0,0,0,.2)"/>
                                <circle cx="35" cy="18" r="2.4" fill="rgba(0,0,0,.2)"/>
                                <circle cx="44" cy="25" r="2.6" fill="rgba(0,0,0,.2)"/>
                                <circle cx="28" cy="33" r="2.2" fill="rgba(0,0,0,.2)"/>
                                <circle cx="40" cy="33" r="2.4" fill="rgba(0,0,0,.2)"/>
                                <circle cx="18" cy="29" r="1.8" fill="rgba(0,0,0,.2)"/>
                                <g class="tw-leg-bl"><line x1="21" y1="37" x2="17" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                                <g class="tw-leg-br"><line x1="30" y1="38" x2="32" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                                <g class="tw-leg-fl"><line x1="47" y1="37" x2="43" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                                <g class="tw-leg-fr"><line x1="55" y1="36" x2="59" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                            </svg>
                        </div>
                        <span class="tw-track-finish">🏁</span>
                    </div>
                </div>

                <div id="tw-c-words" class="tw-words" tabindex="0" aria-label="musobaqa matni"></div>

                <div class="tw-actions">
                    <button id="tw-c-restart" class="btn btn-tw">
                        <i class="bi bi-arrow-repeat me-1"></i>Qaytadan <small class="opacity-75">(Tab)</small>
                    </button>
                    <span class="tw-hint"><i class="bi bi-mouse2 me-1"></i>Yozishni boshlash uchun shu yerga bosing va yozing</span>
                </div>

                <div id="tw-c-result" class="tw-result-screen d-none">
                    <div class="tw-result-top">
                        <div class="tw-result-hero">
                            <div class="tw-hero-stat">
                                <label>wpm</label>
                                <span id="tw-c-r-wpm" class="tw-hero-val">0</span>
                            </div>
                            <div class="tw-hero-stat">
                                <label>aniqlik</label>
                                <span id="tw-c-r-acc" class="tw-hero-val">0<small>%</small></span>
                            </div>
                        </div>
                        <div class="tw-result-chart">
                            <canvas id="tw-c-r-chart" height="200"></canvas>
                            <div id="tw-c-r-tooltip" class="tw-chart-tip" style="display:none"></div>
                            <div class="tw-chart-legend">
                                <span><i class="tw-lg-dot tw-lg-wpm"></i>wpm</span>
                                <span><i class="tw-lg-dot tw-lg-raw"></i>raw</span>
                                <span><i class="tw-lg-dot tw-lg-err"></i>xato</span>
                            </div>
                        </div>
                    </div>

                    <div class="tw-result-meta">
                        <div><label>raw</label><span id="tw-c-r-raw">0</span></div>
                        <div><label>belgilar</label><span id="tw-c-r-chars">0/0</span><small>to'g'ri/xato</small></div>
                        <div><label>barqarorlik</label><span id="tw-c-r-cons">0<small>%</small></span></div>
                        <div><label>vaqt</label><span id="tw-c-r-time">0<small>s</small></span></div>
                        <div><label>o'rin</label><span id="tw-c-r-rank">—</span></div>
                    </div>

                    <p id="tw-c-r-msg" class="tw-r-msg"></p>

                    <div class="tw-result-actions">
                        <button id="tw-c-again" class="btn btn-tw">
                            <i class="bi bi-arrow-repeat me-1"></i>Yana bir bor <small class="opacity-75">(Tab)</small>
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-4">
            <div class="tw-board-card">
                <h6 class="tw-board-title"><i class="bi bi-bar-chart-fill"></i> Bugungi natijalar <small>(top 20)</small></h6>
                <ol id="tw-contest-board" class="tw-ranks tw-contest-ranks"></ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/contest.js" asp-append-version="true"></script>
}
