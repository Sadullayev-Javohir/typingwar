@page
@model SettingsModel
@{
    ViewData["Title"] = "Sozlamalar";
    ViewData["Robots"] = "noindex, follow";
}

<div class="tw-settings-page">

    <!-- Sarlavha -->
    <div class="tw-settings-header">
        <h2><i class="bi bi-gear-fill"></i>Sozlamalar</h2>
        <span class="tw-settings-autosave"><i class="bi bi-cloud-check-fill"></i>Avtomatik saqlanadi</span>
    </div>

    <!-- Jonli ko'rinish -->
    <div class="tw-settings-card tw-preview-card">
        <h4><i class="bi bi-eye"></i>Jonli ko'rinish</h4>
        <div class="tw-preview-words" id="tw-preview-text">the quick brown fox jumps over the lazy dog</div>
        <div class="tw-preview-meta">
            <span id="tw-preview-font-label">JetBrains Mono</span>
            <span id="tw-preview-size-label">18px</span>
            <span id="tw-preview-theme-label">Amber</span>
        </div>
    </div>

    <!-- Shrift: Typing shrifti + o'lcham -->
    <div class="tw-settings-card">
        <h4><i class="bi bi-fonts"></i>Shrift</h4>

        <div class="tw-settings-group">
            <label class="tw-settings-label">Typing Shrifti</label>
            <div class="tw-font-grid" id="tw-font-grid"></div>
        </div>

        <div class="tw-settings-divider" style="margin-top:1.25rem"></div>

        <div class="tw-settings-group" style="margin-top:1.1rem">
            <label class="tw-settings-label">
                Shrift o'lchami —
                <strong class="tw-gold-text" id="fsVal">18</strong>px
            </label>
            <div class="tw-range-wrap">
                <span class="tw-range-hint">14</span>
                <input class="tw-range" type="range" min="14" max="60" step="1"
                       data-tw="fontSize" data-type="int" id="fontSize">
                <span class="tw-range-hint">60</span>
            </div>
        </div>
    </div>

    <!-- Ko'rinish: Tema + Karet -->
    <div class="tw-settings-card">
        <h4><i class="bi bi-palette2"></i>Ko'rinish</h4>

        <div class="tw-settings-group">
            <label class="tw-settings-label">Mavzu</label>
            <div class="tw-theme-grid" id="tw-theme-grid"></div>
        </div>

        <div class="tw-settings-divider" style="margin-top:1.25rem"></div>

        <div class="tw-settings-group" style="margin-top:1.1rem">
            <label class="tw-settings-label">Karet uslubi</label>
            <div class="tw-caret-grid" id="tw-caret-grid"></div>
        </div>

        <div class="tw-settings-divider" style="margin-top:1.1rem"></div>

        <div class="tw-toggle-list" style="margin-top:.6rem">
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title">Silliq karet animatsiyasi</div>
                    <div class="tw-toggle-desc">Karet pozitsiyasi ravon siljiydi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="smoothCaret" data-type="bool" id="smoothCaret">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    <!-- Fon (sahifa orqa foni) -->
    <div class="tw-settings-card">
        <h4><i class="bi bi-image"></i>Fon</h4>
        <div class="tw-settings-group">
            <label class="tw-settings-label">Sahifa orqa foni — Next.js standart, qolgani Vercel uslubida</label>
            <div class="tw-bg-grid" id="tw-bg-grid"></div>
        </div>
    </div>

    <!-- Mashq ko'rinishi -->
    <div class="tw-settings-card">
        <h4><i class="bi bi-layout-text-window"></i>Mashq ko'rinishi</h4>
        <div class="tw-toggle-list">
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-bar-chart-fill me-1" style="color:var(--tw-gold)"></i>Statistika paneli</div>
                    <div class="tw-toggle-desc">WPM, aniqlik va soniyani o'z ichiga olgan katta blok — /Mashq sahifasida ko'rinadi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="showStatsPanel" data-type="bool" id="showStatsPanel">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-flag-fill me-1" style="color:var(--tw-gold)"></i>Mushuk va yo'li</div>
                    <div class="tw-toggle-desc">Yozish davomida oldinga yuguruvchi gepard va poyga yo'lakchasi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="showCheetah" data-type="bool" id="showCheetah">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    <!-- Xulq-atvor -->
    <div class="tw-settings-card">
        <h4><i class="bi bi-sliders2"></i>Xulq-atvor</h4>
        <div class="tw-toggle-list">
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-speedometer2 me-1" style="color:var(--tw-gold)"></i>Jonli WPM ko'rsatkichi</div>
                    <div class="tw-toggle-desc">Yozayotgan paytda tepada WPM bloki ko'rinadi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="showLiveWpm" data-type="bool" id="showLiveWpm">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-bullseye me-1" style="color:var(--tw-gold)"></i>Jonli aniqlik ko'rsatkichi</div>
                    <div class="tw-toggle-desc">Yozayotgan paytda tepada aniqlik bloki ko'rinadi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="showLiveAcc" data-type="bool" id="showLiveAcc">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-clock me-1" style="color:var(--tw-gold)"></i>Jonli soniya ko'rsatkichi</div>
                    <div class="tw-toggle-desc">Yozayotgan paytda tepada soniya/taymer bloki ko'rinadi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="showLiveTimer" data-type="bool" id="showLiveTimer">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-eye-slash me-1" style="color:#8a8aa0"></i>Ko'r rejim</div>
                    <div class="tw-toggle-desc">Xato harflar ko'rsatilmaydi — aniqlikni o'zi his qilasiz</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="blindMode" data-type="bool" id="blindMode">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
            <div class="tw-toggle-row">
                <div class="tw-toggle-info">
                    <div class="tw-toggle-title"><i class="bi bi-x-octagon me-1" style="color:#ff8080"></i>Xatoda to'xtash</div>
                    <div class="tw-toggle-desc">Noto'g'ri tugma bosida keyingisiga o'tilmaydi</div>
                </div>
                <label class="tw-toggle">
                    <input type="checkbox" data-tw="stopOnError" data-type="bool" id="stopOnError">
                    <span class="tw-toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    <!-- Tugma ovozi -->
    <div class="tw-settings-card">
        <h4><i class="bi bi-volume-up"></i>Tugma ovozi</h4>
        <p class="tw-sound-hint"><i class="bi bi-info-circle me-1"></i>Har bir ovozni bosib tinglab ko'ring — qimmat mexanik switch'lar WebAudio orqali sintez qilinadi</p>
        <div class="tw-sound-grid" id="tw-sound-grid"></div>
    </div>

    <!-- Tiklash -->
    <div class="tw-settings-reset-card">
        <span><i class="bi bi-info-circle me-1"></i>Barcha sozlamalar standart qiymatga qaytariladi</span>
        <button class="tw-btn-danger-outline" id="tw-reset-settings">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Tiklash
        </button>
    </div>

</div>

@section Scripts {
    <script src="~/js/settings-page.js" asp-append-version="true"></script>
}
