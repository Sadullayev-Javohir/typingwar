@page
@model MapModel
@{
    ViewData["Title"] = "O'zbekiston typing xaritasi";
}

<div id="tw-map" class="tw-map">
    <div class="tw-map-hero">
        <span class="tw-map-badge">JONLI XARITA</span>
        <h1>O'zbekiston typing xaritasi</h1>
        <p>Har hududda 30 soniyalik rejimda <b>eng tez yozilgan WPM</b>. Issiqroq rang — tezroq hudud. Hudud ustiga bosing.</p>
    </div>

    <div id="tw-map-err" class="text-danger text-center small"></div>

    <div class="tw-map-stage">
        <svg id="tw-uzmap" class="tw-uzmap" viewBox="0 0 1000 600" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="O'zbekiston xaritasi">
            <defs>
                <radialGradient id="twMapGlow" cx="50%" cy="42%" r="70%">
                    <stop offset="0%" stop-color="color-mix(in srgb, var(--tw-gold) 16%, transparent)" />
                    <stop offset="100%" stop-color="transparent" />
                </radialGradient>
                <linearGradient id="twSweep" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="transparent" />
                    <stop offset="45%" stop-color="transparent" />
                    <stop offset="50%" stop-color="rgba(255,255,255,.16)" />
                    <stop offset="55%" stop-color="transparent" />
                    <stop offset="100%" stop-color="transparent" />
                </linearGradient>
                <filter id="twRegGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="5" result="b" />
                    <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <pattern id="twGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                    <path d="M40 0H0V40" fill="none" stroke="rgba(255,255,255,.035)" stroke-width="1" />
                </pattern>
            </defs>

            <rect x="0" y="0" width="1000" height="600" fill="url(#twGrid)" />
            <rect x="0" y="0" width="1000" height="600" fill="url(#twMapGlow)" />

            <g id="tw-regions" stroke-linejoin="round" stroke-linecap="round">
                <g class="tw-region" data-region="KARAKALPAKSTAN">
                    <path d="M95,135 L150,75 L245,52 Q320,62 322,118 Q360,120 352,175 L360,225 L315,255 L250,250 L258,300 L185,312 L120,288 Q72,230 78,180 Z" />
                </g>
                <g class="tw-region" data-region="KHOREZM">
                    <path d="M168,300 L258,300 L250,348 Q245,372 215,372 L175,368 L170,335 Z" />
                </g>
                <g class="tw-region" data-region="NAVOI">
                    <path d="M360,150 L470,140 Q560,150 612,205 L645,290 Q612,335 545,332 L470,328 L405,300 L362,255 L345,210 Z" />
                </g>
                <g class="tw-region" data-region="BUKHARA">
                    <path d="M255,358 L405,330 L470,420 Q440,490 360,508 L300,512 Q245,470 240,420 Z" />
                </g>
                <g class="tw-region" data-region="JIZZAKH">
                    <path d="M600,200 L695,208 Q708,250 700,292 L622,296 L605,250 Z" />
                </g>
                <g class="tw-region" data-region="SAMARKAND">
                    <path d="M470,332 L600,308 L625,395 Q560,420 505,418 L472,375 Z" />
                </g>
                <g class="tw-region" data-region="SYRDARYA">
                    <path d="M702,208 L762,214 Q758,255 750,290 L702,294 L700,248 Z" />
                </g>
                <g class="tw-region" data-region="TASHKENT_REGION">
                    <path d="M700,128 L820,112 Q875,135 892,205 L800,238 L720,232 Q700,185 700,150 Z" />
                </g>
                <g class="tw-region" data-region="TASHKENT_CITY">
                    <circle cx="803" cy="178" r="15" />
                </g>
                <g class="tw-region" data-region="NAMANGAN">
                    <path d="M858,150 L950,138 Q978,150 978,200 L905,218 L868,210 Z" />
                </g>
                <g class="tw-region" data-region="ANDIJAN">
                    <path d="M908,228 L985,232 Q992,265 980,292 L918,286 L905,255 Z" />
                </g>
                <g class="tw-region" data-region="FERGANA">
                    <path d="M815,252 L905,246 Q916,288 908,320 L838,322 L818,295 Z" />
                </g>
                <g class="tw-region" data-region="KASHKADARYA">
                    <path d="M470,425 L620,402 Q668,445 672,498 L545,540 Q480,520 458,470 Z" />
                </g>
                <g class="tw-region" data-region="SURKHANDARYA">
                    <path d="M620,470 L695,456 Q728,510 730,565 L660,568 L628,520 Z" />
                </g>
            </g>

            <g id="tw-region-labels"></g>

            <rect id="tw-map-sweep" x="-300" y="0" width="300" height="600" fill="url(#twSweep)" pointer-events="none" />
        </svg>

        <aside id="tw-region-detail" class="tw-region-detail tw-detail-empty">
            <div class="tw-detail-hint">
                <div class="tw-detail-hint-ico">🗺️</div>
                <p>Hududni tanlang — ishtirokchilar soni va o'rtacha tezlik ko'rinadi.</p>
            </div>
        </aside>
    </div>

    <div class="tw-map-rank">
        <div class="tw-rank-head">
            <h3>Hududlar reytingi</h3>
            <span class="text-muted small">30s rejimi · eng tez WPM bo'yicha</span>
        </div>
        <div id="tw-rank-list" class="tw-rank-list"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}
