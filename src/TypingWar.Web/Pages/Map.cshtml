@page
@model MapModel
@{
    ViewData["Title"] = "O'zbekiston typing xaritasi — hududlar reytingi";
    ViewData["Description"] = "O'zbekistonning 14 hududi bo'yicha jonli typing tezligi xaritasi: qaysi viloyat eng tez yozadi? Issiqlik xaritasi (heat map), hududlar reytingi va real-time statistika.";
}

<div id="tw-map" class="tw-map">
    <div class="tw-map-hero">
        <span class="tw-map-badge">JONLI XARITA</span>
        <h1>O'zbekiston typing xaritasi</h1>
        <p>Har hududda 30 soniyalik rejimda <b>eng tez yozilgan WPM</b>. <b style="color:#2fbf4e">Yashil</b> — eng baland, <b style="color:#f0c419">sariq</b> — o'rtacha, <b style="color:#e8443b">qizil</b> — eng past. Hudud ustiga bosing.</p>
    </div>

    <div id="tw-map-err" class="text-danger text-center small"></div>

    <div class="tw-map-stage">
        <svg id="tw-uzmap" class="tw-uzmap" viewBox="0 0 1000 652" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="O'zbekiston xaritasi" stroke-linecap="round" stroke-linejoin="round">
            <defs>
                <radialGradient id="twMapGlow" cx="50%" cy="42%" r="70%">
                    <stop offset="0%" stop-color="color-mix(in srgb, var(--tw-gold) 16%, transparent)" />
                    <stop offset="100%" stop-color="transparent" />
                </radialGradient>
                <linearGradient id="twSweep" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="transparent" />
                    <stop offset="45%" stop-color="transparent" />
                    <stop offset="50%" stop-color="rgba(255,255,255,.16)" />
                    <stop offset="55%" stop-color="transparent" />
                    <stop offset="100%" stop-color="transparent" />
                </linearGradient>
                <filter id="twRegGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="5" result="b" />
                    <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <pattern id="twGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                    <path d="M40 0H0V40" fill="none" stroke="rgba(255,255,255,.035)" stroke-width="1" />
                </pattern>
            </defs>

            <rect x="0" y="0" width="1000" height="652" fill="url(#twGrid)" />
