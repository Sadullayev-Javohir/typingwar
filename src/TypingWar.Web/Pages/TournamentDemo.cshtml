@page
@model TournamentDemoModel
@{
    ViewData["Title"] = "Turnir simulyatsiyasi";
}

<div id="tw-demo" class="tw-demo">

    <!-- Sarlavha -->
    <header class="tw-demo-hero">
        <span class="tw-demo-badge"><i class="bi bi-cpu"></i> Simulyatsiya</span>
        <h1>Turnir simulyatsiyasi</h1>
        <p>32 ta soxta o'yinchi bilan playoff bracket qanday ishlashini boshqarib kuzating —
           yaratish, boshlash va har bir raundni qadam-baqadam o'ynash.</p>
    </header>

    <!-- Boshqaruv paneli -->
    <div class="tw-demo-panel">
        <div class="tw-demo-controls">
            <button id="tw-d-create" class="tw-rbtn tw-rbtn--gold">
                <i class="bi bi-people-fill"></i><span>32 o'yinchili turnir yaratish</span>
            </button>
            <button id="tw-d-start" class="tw-rbtn tw-rbtn--outline" disabled>
                <i class="bi bi-flag-fill"></i><span>Turnirni boshlash</span>
            </button>
            <button id="tw-d-round" class="tw-rbtn tw-rbtn--outline" disabled>
                <i class="bi bi-play-fill"></i><span>Keyingi raundni o'ynash</span>
            </button>
            <button id="tw-d-auto" class="tw-rbtn tw-rbtn--outline" disabled>
                <i class="bi bi-fast-forward-fill"></i><span>Avtomatik (oxirigacha)</span>
            </button>
            <button id="tw-d-reset" class="tw-rbtn tw-rbtn--danger" disabled>
                <i class="bi bi-trash3"></i><span>O'chirish / yangidan</span>
            </button>
        </div>
        <div id="tw-d-status" class="tw-demo-status">Boshlash uchun «32 o'yinchili turnir yaratish» tugmasini bosing.</div>
    </div>

    <div id="tw-d-err" class="tw-rcard-err text-center"></div>

    <!-- Chempion banneri -->
    <div id="tw-d-champion" class="tw-champion d-none"></div>

    <div class="tw-demo-grid">
        <!-- Chap: bracket / o'yinchilar -->
        <section class="tw-demo-main">
            <h2 class="tw-demo-h2"><i class="bi bi-diagram-3"></i> Bracket</h2>
            <div id="tw-d-bracket-wrap" class="tw-bracket-wrap">
                <div id="tw-d-bracket" class="tw-bracket"></div>
            </div>
            <div id="tw-d-seeds" class="tw-demo-seeds"></div>
            <div id="tw-d-standings" class="tw-demo-standings d-none"></div>
        </section>

        <!-- O'ng: jarayon jurnali -->
        <aside class="tw-demo-side">
            <h2 class="tw-demo-h2"><i class="bi bi-list-ol"></i> Jarayon jurnali</h2>
            <div id="tw-d-log" class="tw-demo-log">
                <div class="tw-demo-log-empty">Bu yerda har bir qadam yoziladi…</div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/tournament-demo.js" asp-append-version="true"></script>
}
