<!DOCTYPE html>
<html lang="uz" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TypingWar.uz</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Fira+Code:wght@400;500;700&family=Source+Code+Pro:wght@400;500;700&family=Space+Mono:wght@400;700&family=IBM+Plex+Mono:wght@400;500;700&family=Roboto+Mono:wght@400;500;700&family=Ubuntu+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TypingWar.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom tw-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <img src="~/img/typingwar-logo.png" alt="TypingWar" height="36" onerror="this.style.display='none'" />
                    <span class="tw-brand">TypingWar<span class="tw-accent">.uz</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house-fill"></i><span>Bosh</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Practice"><i class="bi bi-keyboard"></i><span>Mashq</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Race"><i class="bi bi-flag-fill"></i><span>Poyga</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Rooms"><i class="bi bi-people-fill"></i><span>Xona</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Teams"><i class="bi bi-shield-fill"></i><span>Jamoa</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Contest"><i class="bi bi-calendar-check-fill"></i><span>Kunlik</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Tournaments"><i class="bi bi-trophy-fill"></i><span>Turnir</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Map"><i class="bi bi-map-fill"></i><span>Xarita</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Leaderboard"><i class="bi bi-bar-chart-fill"></i><span>Reyting</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Settings"><i class="bi bi-gear-fill"></i><span>Sozlama</span></a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link tw-nav-link tw-accent" asp-area="" asp-page="/Admin"><i class="bi bi-shield-lock-fill"></i><span>Admin</span></a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link tw-nav-link" asp-area="" asp-page="/Profile"><i class="bi bi-person-circle"></i><span>@User.Identity!.Name</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link tw-nav-link" href="#" id="tw-logout"><i class="bi bi-box-arrow-right"></i><span>Chiqish</span></a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link tw-nav-link" asp-page="/Login"><i class="bi bi-box-arrow-in-right"></i><span>Kirish</span></a></li>
                            <li class="nav-item"><a class="nav-link tw-nav-link tw-accent" asp-page="/Register"><i class="bi bi-person-plus-fill"></i><span>Ro'yxat</span></a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 — TypingWar.uz · <span class="tw-accent">Eng tez barmoqlar g'alaba qozonadi</span>
        </div>
    </footer>

    <!-- Cheetah SVG template (used by TwCheetah helper in site.js) -->
    <template id="tw-ch-tpl">
        <div class="tw-cheetah-run">
            <svg class="tw-cheetah-svg" viewBox="0 0 80 50" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 28 C6 22 3 15 5 8" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                <circle cx="5" cy="8" r="4" fill="currentColor"/>
                <ellipse cx="35" cy="28" rx="22" ry="11" fill="currentColor"/>
                <ellipse cx="54" cy="22" rx="9" ry="8" fill="currentColor"/>
                <circle cx="64" cy="16" r="11" fill="currentColor"/>
                <polygon points="57,8 55,1 61,7" fill="currentColor"/>
                <polygon points="68,7 71,1 73,8" fill="currentColor"/>
                <polygon points="58,8 56.5,3 61,8" fill="rgba(0,0,0,.28)"/>
                <polygon points="69,7 71.5,2 73,8" fill="rgba(0,0,0,.28)"/>
                <g class="tw-eye">
                    <circle cx="68" cy="13" r="3.5" fill="#08081a"/>
                    <circle cx="69" cy="12" r="1.2" fill="rgba(255,255,255,.9)"/>
                </g>
                <path d="M66,20 Q67,23 65,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                <path d="M62,20 Q61,23 63,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                <ellipse cx="74" cy="20" rx="3" ry="2.5" fill="currentColor"/>
                <ellipse cx="74" cy="21" rx="1.5" ry="1.1" fill="rgba(0,0,0,.35)"/>
                <circle cx="25" cy="23" r="2.8" fill="rgba(0,0,0,.2)"/>
                <circle cx="35" cy="18" r="2.4" fill="rgba(0,0,0,.2)"/>
                <circle cx="44" cy="25" r="2.6" fill="rgba(0,0,0,.2)"/>
                <circle cx="28" cy="33" r="2.2" fill="rgba(0,0,0,.2)"/>
                <circle cx="40" cy="33" r="2.4" fill="rgba(0,0,0,.2)"/>
                <circle cx="18" cy="29" r="1.8" fill="rgba(0,0,0,.2)"/>
                <g class="tw-leg-bl"><line x1="21" y1="37" x2="17" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                <g class="tw-leg-br"><line x1="30" y1="38" x2="32" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                <g class="tw-leg-fl"><line x1="47" y1="37" x2="43" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                <g class="tw-leg-fr"><line x1="55" y1="36" x2="59" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
            </svg>
        </div>
    </template>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tw-sound.js" asp-append-version="true"></script>
    <script src="~/js/typing-settings.js" asp-append-version="true"></script>
    <script>
        document.getElementById("tw-logout")?.addEventListener("click", async (e) => {
            e.preventDefault();
            await fetch("/api/auth/logout", { method: "POST", credentials: "same-origin" });
            window.location.href = "/";
        });
        // PWA — service worker (offline app shell + natija navbati)
        if ("serviceWorker" in navigator)
            window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => { }));
    </script>
    <script src="~/js/tw-offline.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
