@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var baseUrl = (Configuration["Site:BaseUrl"] ?? "https://typingwar.uz").TrimEnd('/');
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = ViewData["FullTitle"] as string
        ?? (string.IsNullOrEmpty(pageTitle)
            ? "TypingWar.uz — O'zbekistondagi #1 typing tezligi platformasi"
            : $"{pageTitle} — TypingWar.uz");
    var metaDescription = ViewData["Description"] as string
        ?? "TypingWar.uz — O'zbekistondagi 1-raqamli typing musobaqa platformasi. O'zbek va ingliz tilida yozish tezligingizni (WPM) va aniqligingizni o'lchang: AI raqib, real-time poygalar, jamoaviy musobaqalar, turnirlar va O'zbekiston bo'ylab reyting.";
    var metaKeywords = ViewData["Keywords"] as string
        ?? "typing test, terish tezligi, klaviatura tezligi, o'zbek typing, tez yozish, wpm test, monkeytype o'zbek, ten barmoq, typing musobaqa, typingwar, o'zbekcha klaviatura mashqi, yozish tezligi";
    var robots = ViewData["Robots"] as string ?? "index, follow";
    var canonicalPath = ViewData["Canonical"] as string ?? Context.Request.Path.ToString();
    var canonicalUrl = canonicalPath.StartsWith("http") ? canonicalPath : baseUrl + canonicalPath;
    var ogImage = ViewData["OgImage"] as string ?? (baseUrl + "/img/typingwar-logo.png");
    var ogType = ViewData["OgType"] as string ?? "website";
    var googleVerify = Configuration["Site:GoogleSiteVerification"];
}
<!DOCTYPE html>
<html lang="uz" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@metaKeywords" />
    <meta name="robots" content="@robots" />
    @if (!string.IsNullOrWhiteSpace(googleVerify))
    {
        <meta name="google-site-verification" content="@googleVerify" />
    }
    <meta name="author" content="TypingWar.uz" />
    <meta name="application-name" content="TypingWar.uz" />
    <meta name="generator" content="TypingWar.uz" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="TypingWar.uz" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="uz_UZ" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/img/typingwar-logo.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Fira+Code:wght@400;500;700&family=Source+Code+Pro:wght@400;500;700&family=Space+Mono:wght@400;700&family=IBM+Plex+Mono:wght@400;500;700&family=Roboto+Mono:wght@400;500;700&family=Ubuntu+Mono:wght@400;700&family=DM+Mono:wght@400;500&family=Inconsolata:wght@400;500;700&family=Overpass+Mono:wght@400;500;700&family=Cousine:wght@400;700&family=PT+Mono&family=Anonymous+Pro:wght@400;700&family=Red+Hat+Mono:wght@400;500;700&family=Spline+Sans+Mono:wght@400;500;700&family=B612+Mono:wght@400;700&family=Azeret+Mono:wght@400;500;700&family=Fragment+Mono&family=Noto+Sans+Mono:wght@400;500;700&family=Sometype+Mono:wght@400;500;700&family=Share+Tech+Mono&family=VT323&family=Major+Mono+Display&family=Nova+Mono&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TypingWar.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-pro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global-theme.css" asp-append-version="true" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@graph": [
            {
                "@@type": "Organization",
                "@@id": "@(baseUrl)/#organization",
                "name": "TypingWar.uz",
                "url": "@(baseUrl)/",
                "logo": "@(baseUrl)/img/typingwar-logo.png",
                "description": "O'zbekistondagi #1 typing tezligi va musobaqa platformasi.",
                "slogan": "Eng tez barmoqlar g'alaba qozonadi"
            },
            {
                "@@type": "WebSite",
                "@@id": "@(baseUrl)/#website",
                "url": "@(baseUrl)/",
                "name": "TypingWar.uz",
                "inLanguage": "uz",
                "description": "O'zbek va ingliz tilida yozish tezligingizni o'lchovchi typing musobaqa platformasi.",
                "publisher": { "@@id": "@(baseUrl)/#organization" }
            },
            {
                "@@type": "WebApplication",
                "name": "TypingWar.uz",
                "url": "@(baseUrl)/",
                "applicationCategory": "GameApplication",
                "operatingSystem": "Web",
                "browserRequirements": "Requires JavaScript. Requires HTML5.",
                "inLanguage": ["uz", "en"],
                "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "UZS" }
            }
        ]
    }
    </script>
    @await RenderSectionAsync("StructuredData", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(ViewData["BodyClass"])">
    @* ═══════════ YUKLANISH EKRANI (loader) — sahifa+video tayyor bo'lguncha ═══════════ *@
    <div id="tw-loader" aria-hidden="true">
        <img class="tw-loader-logo" src="~/img/typingwar-logo.png" alt="TypingWar" />
        <div class="tw-loader-bar"></div>
        <div class="tw-loader-text">Yuklanmoqda…</div>
    </div>

    @* ═══════════ ⭐ VIDEO ORQA FON (3 qatlam) — BARCHA SAHIFADA ═══════════ *@
    <div class="tw-bg-fallback" aria-hidden="true"></div>
    <video class="tw-bg-video" muted loop playsinline autoplay preload="auto" aria-hidden="true" tabindex="-1">
        <source src="~/videos/background.mp4" type="video/mp4" />
    </video>
    <div class="tw-bg-overlay" aria-hidden="true"></div>

    <header>
        <nav class="navbar navbar-expand-sm border-bottom tw-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <img src="~/img/typingwar-logo.png" alt="TypingWar" height="36" onerror="this.style.display='none'" />
                    <span class="tw-brand">TypingWar<span class="tw-accent">.uz</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav me-auto tw-nav-icons">
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Index" title="Bosh" aria-label="Bosh"><i class="bi bi-house-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Practice" title="Mashq" aria-label="Mashq"><i class="bi bi-keyboard"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Race" title="Poyga" aria-label="Poyga"><i class="bi bi-flag-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Rooms" title="Xona" aria-label="Xona"><i class="bi bi-people-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Teams" title="Jamoa" aria-label="Jamoa"><i class="bi bi-shield-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Contest" title="Kunlik" aria-label="Kunlik"><i class="bi bi-calendar-check-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Tournaments" title="Turnir" aria-label="Turnir"><i class="bi bi-trophy-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Map" title="Xarita" aria-label="Xarita"><i class="bi bi-map-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Leaderboard" title="Reyting" aria-label="Reyting"><i class="bi bi-bar-chart-fill"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tw-nav-link" asp-area="" asp-page="/Settings" title="Sozlama" aria-label="Sozlama"><i class="bi bi-gear-fill"></i></a>
                        </li>
                    </ul>
                    <ul class="navbar-nav tw-nav-icons">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link tw-nav-link tw-accent" asp-area="" asp-page="/Admin" title="Admin" aria-label="Admin"><i class="bi bi-shield-lock-fill"></i></a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link tw-nav-link" asp-area="" asp-page="/Profile" title="@User.Identity!.Name" aria-label="Profil"><i class="bi bi-person-circle"></i></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link tw-nav-link" href="#" id="tw-logout" title="Chiqish" aria-label="Chiqish"><i class="bi bi-box-arrow-right"></i></a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link tw-nav-link tw-accent" asp-page="/Login" title="Kirish" aria-label="Kirish"><i class="bi bi-google"></i></a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @{
                // Har sahifa kontenti bitta glass KARTA ichida (Race + boshqa sahifalar).
                // Landing (bosh sahifa) va NoPageCard=true bo'lgan sahifalar (masalan
                // Practice — o'zining bo'lim kartalarini beradi) bundan mustasno.
                var noPageCard = (ViewData["NoPageCard"] as bool?) ?? false;
                var isLanding = (ViewData["BodyClass"] as string)?.Contains("tw-landing-page") == true;
            }
            @if (noPageCard || isLanding)
            {
                @RenderBody()
            }
            else
            {
                <div class="tw-page-card">
                    @RenderBody()
                </div>
            }
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 — TypingWar.uz · <span class="tw-accent">Eng tez barmoqlar g'alaba qozonadi</span>
        </div>
    </footer>

    <!-- Cheetah SVG template (used by TwCheetah helper in site.js) -->
    <template id="tw-ch-tpl">
        <div class="tw-cheetah-run">
            <svg class="tw-cheetah-svg" viewBox="0 0 80 50" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 28 C6 22 3 15 5 8" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                <circle cx="5" cy="8" r="4" fill="currentColor"/>
                <ellipse cx="35" cy="28" rx="22" ry="11" fill="currentColor"/>
                <ellipse cx="54" cy="22" rx="9" ry="8" fill="currentColor"/>
                <circle cx="64" cy="16" r="11" fill="currentColor"/>
                <polygon points="57,8 55,1 61,7" fill="currentColor"/>
                <polygon points="68,7 71,1 73,8" fill="currentColor"/>
                <polygon points="58,8 56.5,3 61,8" fill="rgba(0,0,0,.28)"/>
                <polygon points="69,7 71.5,2 73,8" fill="rgba(0,0,0,.28)"/>
                <g class="tw-eye">
                    <circle cx="68" cy="13" r="3.5" fill="#08081a"/>
                    <circle cx="69" cy="12" r="1.2" fill="rgba(255,255,255,.9)"/>
                </g>
                <path d="M66,20 Q67,23 65,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                <path d="M62,20 Q61,23 63,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                <ellipse cx="74" cy="20" rx="3" ry="2.5" fill="currentColor"/>
                <ellipse cx="74" cy="21" rx="1.5" ry="1.1" fill="rgba(0,0,0,.35)"/>
                <circle cx="25" cy="23" r="2.8" fill="rgba(0,0,0,.2)"/>
                <circle cx="35" cy="18" r="2.4" fill="rgba(0,0,0,.2)"/>
                <circle cx="44" cy="25" r="2.6" fill="rgba(0,0,0,.2)"/>
                <circle cx="28" cy="33" r="2.2" fill="rgba(0,0,0,.2)"/>
                <circle cx="40" cy="33" r="2.4" fill="rgba(0,0,0,.2)"/>
                <circle cx="18" cy="29" r="1.8" fill="rgba(0,0,0,.2)"/>
                <g class="tw-leg-bl"><line x1="21" y1="37" x2="17" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                <g class="tw-leg-br"><line x1="30" y1="38" x2="32" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                <g class="tw-leg-fl"><line x1="47" y1="37" x2="43" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                <g class="tw-leg-fr"><line x1="55" y1="36" x2="59" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
            </svg>
        </div>
    </template>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tw-sound.js" asp-append-version="true"></script>
    <script src="~/js/typing-settings.js" asp-append-version="true"></script>
    <script nonce="@ViewContext.HttpContext.Items["csp-nonce"]">
        document.getElementById("tw-logout")?.addEventListener("click", async (e) => {
            e.preventDefault();
            await fetch("/api/auth/logout", { method: "POST", credentials: "same-origin" });
            window.location.href = "/";
        });
        // PWA — service worker (offline app shell + natija navbati)
        // Versiyalangan URL: Cloudflare bare "/sw.js"ni eski cache'lagan bo'lsa ham
        // "?v=79" yangi URL => edge BYPASS => yangi worker darhol o'rnatiladi (o'z-o'zini tuzatadi).
        if ("serviceWorker" in navigator)
            window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js?v=80").catch(() => { }));

        // ─── YUKLANISH EKRANINI YASHIRISH ───
        // Sahifa tayyor bo'lgach loader silliq yo'qoladi. Bir necha signal:
        //   • window "load" (barcha resurs) • hard-cap taymer (hech qachon osilib qolmasin)
        (function () {
            var loader = document.getElementById('tw-loader');
            if (!loader) return;
            var hidden = false;
            var hide = function () {
                if (hidden) return; hidden = true;
                loader.classList.add('tw-loader-hide');
                setTimeout(function () { if (loader.parentNode) loader.parentNode.removeChild(loader); }, 600);
            };
            if (document.readyState === 'complete') { hide(); return; }
            window.addEventListener('load', function () { setTimeout(hide, 120); });
            // Kafolat: 4s dan keyin qanday bo'lmasin yashiramiz (video sekin bo'lsa ham)
            setTimeout(hide, 4000);
        })();

        // ─── VIDEO ORQA FON AUTOPLAY + SILLIQ PAYDO BO'LISH (barcha sahifa) ───
        // Brauzerlar autoplay'ni bloklashi mumkin — bir necha nuqtada qayta urinamiz.
        // Video HAQIQATAN o'ynay boshlaganda "tw-video-on" klassi qo'shiladi →
        // muzlagan birinchi kadr KO'RINMAYDI, video silliq fade bilan chiqadi.
        (function () {
            var vids = document.querySelectorAll('.tw-bg-video, .tw-hero-video');
            if (!vids.length) return;
            var reveal = function (v) { v.classList.add('tw-video-on'); };
            var tryPlay = function () {
                vids.forEach(function (v) {
                    if (v.tagName !== 'VIDEO') return;
                    v.muted = true;
                    var p = v.play();
                    if (p && p.then) p.then(function () { reveal(v); }).catch(function () { });
                });
            };
            vids.forEach(function (v) {
                v.addEventListener('playing', function () { reveal(v); });
                v.addEventListener('loadeddata', tryPlay);
                // Agar video allaqachon o'ynayotgan bo'lsa (cache'dan tez) — darhol ko'rsat
                if (v.readyState >= 3 && !v.paused) reveal(v);
            });
            document.addEventListener('DOMContentLoaded', tryPlay);
            document.addEventListener('click', tryPlay, { once: true });
            tryPlay();
        })();
    </script>
    <script src="~/js/tw-offline.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
