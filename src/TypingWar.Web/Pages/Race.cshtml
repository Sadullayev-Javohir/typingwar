@page
@model RaceModel
@{
    ViewData["Title"] = "AI bilan poyga — typing musobaqasi";
    ViewData["Description"] = "Sun'iy intellekt raqibga qarshi yozish poygasi, Ghost rejimida o'z rekordingizga qarshi va Blind Duel — TypingWar.uz da real-time typing musobaqasi.";
}

<div id="tw-racepage" class="tw-racepage">
    <h2 class="tw-accent text-center mb-3">Poyga</h2>

    <div class="tw-config">
        <div class="tw-config-group" data-group="racemode">
            <span class="tw-config-label"><i class="bi bi-controller"></i>Raqib:</span>
            <button class="tw-opt tw-active" data-mode="AI"><i class="bi bi-robot"></i> AI</button>
            <button class="tw-opt" data-mode="Ghost"><i class="bi bi-moon-stars"></i> Ghost</button>
            <button class="tw-opt" data-mode="Blind"><i class="bi bi-eye-slash"></i> Blind</button>
        </div>
        <div class="tw-config-group" data-group="language">
            <span class="tw-config-label"><i class="bi bi-translate"></i>Til:</span>
            <button class="tw-opt" data-key="language" data-value="Uzbek">uz</button>
            <button class="tw-opt" data-key="language" data-value="English">en</button>
        </div>
        <div class="tw-config-group" data-group="mode">
            <span class="tw-config-label"><i class="bi bi-type"></i>Rejim:</span>
            <button class="tw-opt" data-key="textMode" data-value="Words">so'z</button>
            <button class="tw-opt" data-key="textMode" data-value="Sentences">Iqtiboslar</button>
            <button class="tw-opt" data-key="textMode" data-value="Numbers">raqam</button>
            <button class="tw-opt" data-key="textMode" data-value="Code">kod</button>
        </div>
        <div class="tw-config-group" data-group="quote" style="display:none">
            <span class="tw-config-label"><i class="bi bi-rulers"></i>Uzunlik:</span>
            <button class="tw-opt" data-key="quoteLength" data-value="all">barchasi</button>
            <button class="tw-opt" data-key="quoteLength" data-value="short">qisqa</button>
            <button class="tw-opt" data-key="quoteLength" data-value="medium">o'rta</button>
            <button class="tw-opt" data-key="quoteLength" data-value="long">uzun</button>
            <button class="tw-opt" data-key="quoteLength" data-value="thick">juda uzun</button>
        </div>
        <div class="tw-config-group" data-group="count">
            <span class="tw-config-label"><i class="bi bi-hash"></i>So'z:</span>
            <button class="tw-opt" data-key="wordCount" data-value="10">10</button>
            <button class="tw-opt" data-key="wordCount" data-value="25">25</button>
            <button class="tw-opt" data-key="wordCount" data-value="50">50</button>
        </div>
    </div>

    <div class="text-center mb-3" id="tw-race-startwrap">
        <button id="tw-race-start" class="btn btn-tw">
            <i class="bi bi-play-fill me-1"></i>Boshlash
        </button>
        <div id="tw-race-err" class="text-danger mt-2"></div>
    </div>

    <div id="tw-vs" class="tw-vs d-none">
        <div class="tw-vs-row">
            <span class="tw-vs-name"><i class="bi bi-person-fill" style="color:var(--tw-gold)"></i>Siz</span>
            <div class="tw-track"><div id="tw-you-bar" class="tw-cheetah-run tw-cheetah-gold">
                <svg class="tw-cheetah-svg" viewBox="0 0 80 50" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 28 C6 22 3 15 5 8" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                    <circle cx="5" cy="8" r="4" fill="currentColor"/>
                    <ellipse cx="35" cy="28" rx="22" ry="11" fill="currentColor"/>
                    <ellipse cx="54" cy="22" rx="9" ry="8" fill="currentColor"/>
                    <circle cx="64" cy="16" r="11" fill="currentColor"/>
                    <polygon points="57,8 55,1 61,7" fill="currentColor"/><polygon points="68,7 71,1 73,8" fill="currentColor"/>
                    <polygon points="58,8 56.5,3 61,8" fill="rgba(0,0,0,.28)"/><polygon points="69,7 71.5,2 73,8" fill="rgba(0,0,0,.28)"/>
                    <g class="tw-eye"><circle cx="68" cy="13" r="3.5" fill="#08081a"/><circle cx="69" cy="12" r="1.2" fill="rgba(255,255,255,.9)"/></g>
                    <path d="M66,20 Q67,23 65,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    <path d="M62,20 Q61,23 63,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    <ellipse cx="74" cy="20" rx="3" ry="2.5" fill="currentColor"/><ellipse cx="74" cy="21" rx="1.5" ry="1.1" fill="rgba(0,0,0,.35)"/>
                    <circle cx="25" cy="23" r="2.8" fill="rgba(0,0,0,.2)"/><circle cx="35" cy="18" r="2.4" fill="rgba(0,0,0,.2)"/>
                    <circle cx="44" cy="25" r="2.6" fill="rgba(0,0,0,.2)"/><circle cx="28" cy="33" r="2.2" fill="rgba(0,0,0,.2)"/>
                    <circle cx="40" cy="33" r="2.4" fill="rgba(0,0,0,.2)"/><circle cx="18" cy="29" r="1.8" fill="rgba(0,0,0,.2)"/>
                    <g class="tw-leg-bl"><line x1="21" y1="37" x2="17" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                    <g class="tw-leg-br"><line x1="30" y1="38" x2="32" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                    <g class="tw-leg-fl"><line x1="47" y1="37" x2="43" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                    <g class="tw-leg-fr"><line x1="55" y1="36" x2="59" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                </svg>
            </div><span class="tw-track-finish">🏁</span></div>
            <span id="tw-you-wpm" class="tw-vs-wpm">0</span>
        </div>
        <div class="tw-vs-row">
            <span id="tw-opp-name" class="tw-vs-name"><i class="bi bi-robot"></i>Raqib</span>
            <div class="tw-track"><div id="tw-opp-bar" class="tw-cheetah-run tw-cheetah-gray">
                <svg class="tw-cheetah-svg" viewBox="0 0 80 50" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 28 C6 22 3 15 5 8" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                    <circle cx="5" cy="8" r="4" fill="currentColor"/>
                    <ellipse cx="35" cy="28" rx="22" ry="11" fill="currentColor"/>
                    <ellipse cx="54" cy="22" rx="9" ry="8" fill="currentColor"/>
                    <circle cx="64" cy="16" r="11" fill="currentColor"/>
                    <polygon points="57,8 55,1 61,7" fill="currentColor"/><polygon points="68,7 71,1 73,8" fill="currentColor"/>
                    <polygon points="58,8 56.5,3 61,8" fill="rgba(0,0,0,.28)"/><polygon points="69,7 71.5,2 73,8" fill="rgba(0,0,0,.28)"/>
                    <g class="tw-eye"><circle cx="68" cy="13" r="3.5" fill="#08081a"/><circle cx="69" cy="12" r="1.2" fill="rgba(255,255,255,.9)"/></g>
                    <path d="M66,20 Q67,23 65,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    <path d="M62,20 Q61,23 63,26" stroke="rgba(0,0,0,.3)" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                    <ellipse cx="74" cy="20" rx="3" ry="2.5" fill="currentColor"/><ellipse cx="74" cy="21" rx="1.5" ry="1.1" fill="rgba(0,0,0,.35)"/>
                    <circle cx="25" cy="23" r="2.8" fill="rgba(0,0,0,.2)"/><circle cx="35" cy="18" r="2.4" fill="rgba(0,0,0,.2)"/>
                    <circle cx="44" cy="25" r="2.6" fill="rgba(0,0,0,.2)"/><circle cx="28" cy="33" r="2.2" fill="rgba(0,0,0,.2)"/>
                    <circle cx="40" cy="33" r="2.4" fill="rgba(0,0,0,.2)"/><circle cx="18" cy="29" r="1.8" fill="rgba(0,0,0,.2)"/>
                    <g class="tw-leg-bl"><line x1="21" y1="37" x2="17" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                    <g class="tw-leg-br"><line x1="30" y1="38" x2="32" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                    <g class="tw-leg-fl"><line x1="47" y1="37" x2="43" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                    <g class="tw-leg-fr"><line x1="55" y1="36" x2="59" y2="48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></g>
                </svg>
            </div><span class="tw-track-finish">🏁</span></div>
            <span id="tw-opp-wpm" class="tw-vs-wpm">0</span>
        </div>
    </div>

    <div id="tw-race-countdown" class="tw-countdown d-none"></div>
    <div id="tw-race-area" class="d-none">
        <div id="tw-race-words" class="tw-words" tabindex="0"></div>
    </div>

    <div id="tw-race-result" class="tw-result-screen d-none">
        <h3 id="tw-race-verdict" class="tw-race-verdict text-center"></h3>

        <div class="tw-result-top">
            <div class="tw-result-hero">
                <div class="tw-hero-stat">
                    <label>wpm</label>
                    <span id="tw-rr-wpm" class="tw-hero-val">0</span>
                </div>
                <div class="tw-hero-stat">
                    <label>aniqlik</label>
                    <span id="tw-rr-acc" class="tw-hero-val">0<small>%</small></span>
                </div>
            </div>
            <div class="tw-result-chart">
                <canvas id="tw-rr-chart" height="200"></canvas>
                <div id="tw-rr-tooltip" class="tw-chart-tip" style="display:none"></div>
                <div class="tw-chart-legend">
                    <span><i class="tw-lg-dot tw-lg-wpm"></i>siz</span>
                    <span><i class="tw-lg-dot tw-lg-ai"></i><span id="tw-rr-opp-legend">raqib</span></span>
                    <span><i class="tw-lg-dot tw-lg-err"></i>xato</span>
                </div>
            </div>
        </div>

        <div class="tw-versus">
            <div class="tw-versus-card tw-versus-you">
                <div class="tw-versus-name"><i class="bi bi-person-fill"></i>Siz</div>
                <div class="tw-versus-stats">
                    <div><label>wpm</label><span id="tw-vs-you-wpm">0</span></div>
                    <div><label>aniqlik</label><span id="tw-vs-you-acc">0<small>%</small></span></div>
                    <div><label>vaqt</label><span id="tw-vs-you-time">0<small>s</small></span></div>
                </div>
            </div>
            <div class="tw-versus-vs">VS</div>
            <div class="tw-versus-card tw-versus-opp">
                <div class="tw-versus-name"><i class="bi bi-robot"></i><span id="tw-versus-opp-name">Raqib</span></div>
                <div class="tw-versus-stats">
                    <div><label>wpm</label><span id="tw-vs-opp-wpm">0</span></div>
                    <div><label>aniqlik</label><span id="tw-vs-opp-acc">100<small>%</small></span></div>
                    <div><label>vaqt</label><span id="tw-vs-opp-time">0<small>s</small></span></div>
                </div>
            </div>
        </div>

        <div class="tw-result-meta">
            <div><label>raw</label><span id="tw-rr-raw">0</span></div>
            <div><label>belgilar</label><span id="tw-rr-chars">0/0</span><small>to'g'ri/xato</small></div>
            <div><label>barqarorlik</label><span id="tw-rr-cons">0<small>%</small></span></div>
            <div><label>rejim</label><span id="tw-rr-mode">—</span></div>
        </div>

        <p id="tw-race-msg" class="tw-r-msg text-center"></p>

        <div class="tw-result-actions">
            <button id="tw-race-again" class="btn btn-tw">
                <i class="bi bi-arrow-repeat me-1"></i>Yana bir bor
            </button>
            <button id="tw-race-config" class="btn btn-tw-outline">
                <i class="bi bi-sliders me-1"></i>Sozlamalar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/race.js" asp-append-version="true"></script>
}
