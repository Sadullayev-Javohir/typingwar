@page
@model RoomModel
@{
    ViewData["Title"] = "Xona";
    ViewData["Robots"] = "noindex, nofollow";
}

<div id="tw-room"
     class="tw-room-page"
     data-authenticated="@Model.IsAuthenticated.ToString().ToLower()"
     data-username="@Model.Username">

    <div class="tw-room-head text-center mb-3">
        <span class="text-secondary">Xona kodi:</span>
        <span id="tw-room-code" class="tw-room-code"></span>
        <button id="tw-copy" class="btn btn-sm btn-outline-warning ms-2">nusxa</button>
    </div>

    <div id="tw-room-err" class="text-danger text-center"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <h6 class="text-secondary">O'yinchilar</h6>
            <ul id="tw-players" class="tw-players"></ul>
            <button id="tw-start" class="btn btn-tw w-100 mt-2 d-none">Boshlash (host)</button>
            <p id="tw-wait" class="text-secondary small mt-2">Host boshlashini kuting…</p>
        </div>

        <div class="col-md-8">
            <div id="tw-countdown" class="tw-countdown d-none"></div>
            <div id="tw-race" class="d-none">
                <div class="tw-stats" id="tw-room-stats">
                    <div class="tw-stat" id="tw-stat-wpm">
                        <span id="tw-wpm">0</span>
                        <label><i class="bi bi-speedometer2"></i>WPM</label>
                    </div>
                    <div class="tw-stat" id="tw-stat-acc">
                        <span id="tw-acc">100</span>
                        <label><i class="bi bi-bullseye"></i>Aniqlik %</label>
                    </div>
                    <div class="tw-stat" id="tw-stat-timer">
                        <span id="tw-timer">0</span>
                        <label><i class="bi bi-clock"></i>Soniya</label>
                    </div>
                </div>
                <div id="tw-room-wordswrap" class="tw-wordswrap">
                    <div id="tw-room-words" class="tw-words" tabindex="0"></div>
                    <div id="tw-sab-banner" class="tw-sab-banner d-none"></div>
                </div>

                <div id="tw-sabotage" class="tw-sabotage d-none">
                    <span class="tw-sab-label">💥 Sabotaj <small>(poygada 1×, kuchli raqibga)</small>:</span>
                    <div class="tw-sab-btns">
                        <button class="tw-sab-btn" data-sab="Blackout">🌑 Blackout</button>
                        <button class="tw-sab-btn" data-sab="Shuffle">🔀 Shuffle</button>
                        <button class="tw-sab-btn" data-sab="Shake">📳 Shake</button>
                        <button class="tw-sab-btn" data-sab="Mirror">🪞 Mirror</button>
                        <button class="tw-sab-btn" data-sab="Slowdown">🐌 Slowdown</button>
                    </div>
                </div>
                <ul id="tw-sab-feed" class="tw-sab-feed"></ul>
            </div>
            <div id="tw-room-result" class="tw-room-result d-none">
                <div class="tw-rr-head">
                    <i class="bi bi-trophy-fill"></i>
                    <h4>Poyga natijalari</h4>
                    <p id="tw-rr-sub">Barcha o'yinchilar statistikasi</p>
                </div>

                <div class="tw-rr-chart">
                    <canvas id="tw-room-chart" height="220"></canvas>
                    <div id="tw-room-chart-tip" class="tw-chart-tip" style="display:none"></div>
                    <div id="tw-room-legend" class="tw-rr-legend"></div>
                </div>

                <div id="tw-room-cards" class="tw-rr-cards"></div>

                <div class="tw-rr-actions">
                    <button id="tw-restart" class="btn btn-tw d-none">
                        <i class="bi bi-arrow-repeat me-1"></i>Qaytadan boshlash
                    </button>
                    <p id="tw-rr-wait" class="text-secondary small mb-0 d-none">
                        Host yangi poyga boshlashini kuting…
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/room.js" asp-append-version="true"></script>
}
