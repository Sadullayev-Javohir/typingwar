@page
@model ProfileModel
@{
    ViewData["Title"] = "Profil";
}

@if (!Model.IsAuthenticated)
{
    <div class="tw-profile2">
        <p class="text-center text-secondary mt-5">
            Profilingizni ko'rish uchun <a asp-page="/Login" class="tw-accent">tizimga kiring</a>.
        </p>
    </div>
}
else
{
    <div id="tw-profile-root" class="tw-profile2" data-endpoint="/api/profile" data-own="true">
        <div class="tw-profile-loading">Profil yuklanmoqda…</div>
    </div>
}

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
