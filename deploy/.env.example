# TypingWar.uz — PRODUCTION sozlamalari
# Bu faylni serverda ".env" nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp deploy/.env.example .env
# .env hech qachon git ga qo'shilmaydi (.gitignore da bor).

# ── PostgreSQL paroli (kuchli, tasodifiy bo'lsin) ──────────────
# Yaratish:  openssl rand -base64 24
POSTGRES_PASSWORD=ALMASHTIRING_kuchli_parol

# ── JWT imzo kaliti (kamida 32 belgi, tasodifiy) ───────────────
# Yaratish:  openssl rand -base64 48
JWT_KEY=ALMASHTIRING_kamida_32_belgilik_tasodifiy_maxfiy_kalit

# ── HTTPS redirect ─────────────────────────────────────────────
# HTTP-first bosqichida false qoldiring. SSL ulangach ham nginx redirect qiladi,
# shuning uchun odatda false yetarli.
USE_HTTPS_REDIRECTION=false

# ── Ruxsat etilgan Host'lar (Host-header in'ektsiyasi himoyasi) ──
# DNS ulangach domeningiz bilan cheklang (nginx ham server_name bilan himoyalaydi).
# Misol:  ALLOWED_HOSTS=typingwar.uz;www.typingwar.uz
# IP orqali kirish kerak bo'lsa (DNS hali yo'q) "*" qoldiring.
ALLOWED_HOSTS=*

# ── Google OAuth (login uchun shart) ──────────────────────────
# https://console.cloud.google.com -> Credentials -> OAuth client (Web)
# Authorized redirect URI:  https://typingwar.uz/signin-google
# (DNS+SSL ulanmaguncha bo'sh qoldirsa bo'ladi — sahifalar ochiladi, login ishlamaydi)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin (ixtiyoriy) — shu email bilan kirgan user Admin roli oladi ──
ADMIN_EMAIL=
# SuperAdmin — to'liq huquqli (foydalanuvchi/turnir o'chirish, rol berish). Bo'sh qoldirilsa standart qiymat.
ADMIN_SUPER_EMAIL=javohirsadullayev836@gmail.com

# ── Google Search Console (SEO tasdiqlash) — "HTML tag" usulidagi token ──
# Search Console -> Settings -> Ownership verification -> HTML tag dan
# <meta name="google-site-verification" content="XXXX"> ichidagi XXXX qiymatini bu yerga qo'ying.
GOOGLE_SITE_VERIFICATION=
